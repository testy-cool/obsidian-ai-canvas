{
    "root": true,
    "parser": "@typescript-eslint/parser",
    "env": { "node": true },
    "plugins": [
      "@typescript-eslint",
      "unused-imports"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/eslint-recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "parserOptions": {
        "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "off",
      // An unused import is always safe to delete, and this rule's fix does it,
      // which the base no-unused-vars rule cannot. Keep both: this one for
      // imports, the other for variables a person has to look at.
      "unused-imports/no-unused-imports": "error",
      // Unused function arguments are often required by a callback signature.
      // A rest-sibling omit (`const { label: _label, ...rest } = data`) is a
      // deliberate pattern, and an underscore marks a binding kept on purpose.
      "@typescript-eslint/no-unused-vars": ["error", {
        "args": "none",
        "ignoreRestSiblings": true,
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }],
      // Obsidian does not expose the Canvas API, so the internals it is driven
      // through are untyped by necessity. `any` and non-null assertions are how
      // this codebase talks to them; flagging every one buries real problems.
      "@typescript-eslint/no-explicit-any": "off",
      "@typescript-eslint/no-non-null-assertion": "off",
      "@typescript-eslint/ban-ts-comment": "off",
      "no-prototype-builtins": "off",
      "@typescript-eslint/no-empty-function": "off"
    }
  }
